#!/usr/bin/env bash
# Open path under copy-mode cursor (or selection) in an existing nvim/vim pane,
# or split a pane on the right and start the editor there.
# Always exits 0 so tmux run-shell does not show a failure flash.
set -uo pipefail

pane=$(tmux display-message -p '#{pane_id}')
cwd=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
selection_present=$(tmux display-message -p '#{selection_present}')

# Read selection via pipe only (-C no terminal clipboard, -P no paste buffer).
read_selection() {
    local tmp done
    tmp=$(mktemp)
    done=$(mktemp)
    rm -f "$done"
    tmux send-keys -t "$pane" -X copy-pipe-no-clear -C -P "cat >$(printf %q "$tmp"); touch $(printf %q "$done")"
    local i=0
    while [[ ! -f "$done" && $i -lt 100 ]]; do
        sleep 0.01
        i=$((i + 1))
    done
    if [[ -f "$tmp" ]]; then
        cat "$tmp"
    fi
    rm -f "$tmp" "$done"
}

# Word under cursor: spaces only as separators so full paths stay intact
# (tmux word-separators include / and ~, so copy_cursor_word is unusable).
read_word_at_cursor() {
    local line x s e word
    line=$(tmux display-message -p '#{copy_cursor_line}')
    x=$(tmux display-message -p '#{copy_cursor_x}')
    s=$x
    while [[ $s -gt 0 && "${line:$((s-1)):1}" != ' ' ]]; do
        s=$((s - 1))
    done
    e=$x
    while [[ $e -lt ${#line} && "${line:$e:1}" != ' ' ]]; do
        e=$((e + 1))
    done
    word="${line:$s:$((e-s))}"
    # strip common trailing punctuation from URLs/paths in prose
    sed 's/[].,;:)>]*$//' <<<"$word"
}

resolve_path() {
    local f="$1"
    # expand ~ and make absolute relative to the pane cwd
    # quote patterns so bash does not expand ~ before matching
    if [[ "$f" == "~" || "$f" == "~/"* ]]; then
        f="${HOME}${f:1}"
    fi
    if [[ "$f" != /* ]]; then
        f="$cwd/$f"
    fi
    # collapse . / .. without requiring the file to exist (macOS realpath lacks -m)
    python3 -c 'import os,sys; print(os.path.normpath(sys.argv[1]))' "$f"
}

open_in_existing() {
    local target="$1" file="$2" linenum="$3"
    local escaped
    escaped=$(printf "%s" "$file" | sed "s/'/''/g")
    if [[ -n "$linenum" ]]; then
        tmux send-keys -t "$target" Escape ":execute 'edit +${linenum}' fnameescape('${escaped}')" Enter
    else
        tmux send-keys -t "$target" Escape ":execute 'edit' fnameescape('${escaped}')" Enter
    fi
}

if [[ "$selection_present" == "1" ]]; then
    input=$(read_selection)
else
    input=$(read_word_at_cursor)
fi
# trim whitespace / newlines from selection
input=$(printf '%s' "$input" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
# strip surrounding quotes
if [[ "$input" =~ ^\".*\"$ || "$input" =~ ^\'.*\'$ ]]; then
    input="${input:1:${#input}-2}"
fi

if [[ -z "$input" ]]; then
    tmux display-message "no path under cursor"
    exit 0
fi

file="$input"
linenum=""
if [[ "$input" =~ ^(.+):([0-9]+)(:[0-9]+)?$ ]]; then
    file="${BASH_REMATCH[1]}"
    linenum="${BASH_REMATCH[2]}"
fi
file=$(resolve_path "$file")

vim_pane=$(tmux list-panes -F "#{pane_id} #{pane_current_command}" | grep -E " (n?vim)$" | head -1 | awk '{print $1}' || true)

tmux send-keys -t "$pane" -X cancel 2>/dev/null || true

if [[ -z "$vim_pane" ]]; then
    editor=$(command -v nvim 2>/dev/null || command -v vim 2>/dev/null || true)
    if [[ -z "$editor" ]]; then
        tmux display-message "nvim/vim not found"
        exit 0
    fi

    if [[ -n "$linenum" ]]; then
        cmd=$(printf '%q +%s -- %q' "$editor" "$linenum" "$file")
    else
        cmd=$(printf '%q -- %q' "$editor" "$file")
    fi
    vim_pane=$(tmux split-window -h -P -F '#{pane_id}' -c "$cwd" "$cmd") || {
        tmux display-message "failed to split pane for editor"
        exit 0
    }
else
    open_in_existing "$vim_pane" "$file" "$linenum"
fi

tmux select-pane -t "$vim_pane" 2>/dev/null || true
exit 0
